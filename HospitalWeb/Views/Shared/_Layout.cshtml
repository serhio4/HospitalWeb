<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HospitalWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @{
                        // 1. Verificam URL-ul curent
                        var path = Context.Request.Path.Value?.ToLower();
                        // 2. Decidem daca afisam meniul (DOAR daca NU suntem pe Login sau Register)
                        var showMenu = path != null && !path.Contains("/account/login") && !path.Contains("/account/register");
                    }

                    @if (showMenu)
                    {
                        // AICI ESTE MENIUL TAU EXISTENT (L-am bagat in IF)
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Acasă</a>
                            </li>

                            @if (User.IsInRole("Doctor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Appointments" asp-action="Index">Programul Meu</a>
                                </li>
                            }
                            else if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Appointments" asp-action="Index">Programări</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Doctors" asp-action="Index">Doctori</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Departments" asp-action="Index">Secții</a>
                                </li>
                            }

                            else // Pacient (sau User logat care nu e Doctor/Admin)
                            {
                                // Afisam link-ul doar daca e logat, ca sa nu apara la vizitatori simpli
                                if (User.Identity.IsAuthenticated)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Appointments" asp-action="Index">Programările Mele</a>
                                    </li>
                                }
                            }

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reviews" asp-action="Index">Recenzii</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        // Daca suntem pe Login/Register, punem un spatiu gol ca sa impinga butonul de Login in dreapta
                        <ul class="navbar-nav flex-grow-1"></ul>
                    }

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - HospitalWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Confidențialitate</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
