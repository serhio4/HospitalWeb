@model ErrorViewModel
@{
    ViewData["Title"] = "Eroare";
}

<h1 class="text-danger">Eroare.</h1>
<h2 class="text-danger">A apărut o eroare la procesarea cererii tale.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID cerere:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modul de Dezvoltare</h3>
<p>
    Comutarea la mediul <strong>Development</strong> va afișa informații mai detaliate despre eroarea apărută.
</p>
<p>
    <strong>Mediul Development nu ar trebui activat pentru aplicațiile în producție.</strong>
    Poate duce la afișarea de informații sensibile din excepții utilizatorilor finali.
    Pentru depanare locală, activați mediul <strong>Development</strong> setând variabila de mediu <strong>ASPNETCORE_ENVIRONMENT</strong> la valoarea <strong>Development</strong>
    și reporniți aplicația.
</p>
