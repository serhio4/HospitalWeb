@model HospitalWeb.Models.Appointment

@{
    ViewData["Title"] = "Ștergere";
}

<h1>Ștergere</h1>

<h3 class="text-danger">Ești sigur că vrei să ștergi această programare?</h3>
<div>
    <hr />
    <dl class="row mt-4">
        @* DATA SI ORA PROGRAMARII *@
        <dt class="col-sm-2">
            Data și Ora
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AppointmentDate)
        </dd>

        @* DOCTORUL *@
        <dt class="col-sm-2">
            Doctor
        </dt>
        <dd class="col-sm-10">
            @Model.Doctor.FullName <span class="text-muted">(@Model.Doctor.Email)</span>
        </dd>

        @* PACIENTUL *@
        <dt class="col-sm-2">
            Pacient
        </dt>
        <dd class="col-sm-10">
            @Model.Patient.FullName <span class="text-muted">(@Model.Patient.Email)</span>
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Șterge Definitiv</button>
        <a asp-action="Index" class="btn btn-link text-dark">Înapoi la Listă</a>
    </form>
</div>