@model IEnumerable<HospitalWeb.Models.Patient>

@{
    ViewData["Title"] = "Pacienți";
}

<h1>Pacienți</h1>

<p>
    <a asp-action="Create">Adaugă Nou</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CNP)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhoneNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CNP)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editează</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalii</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Șterge</a>
            </td>
        </tr>
}
    </tbody>
</table>
