@model HospitalWeb.Models.Review

@{
    ViewData["Title"] = "Ștergere Recenzie";
}

<h1>Ștergere Recenzie</h1>

<h3 class="text-danger">Ești sigur că vrei să ștergi această recenzie?</h3>
<div>
    <hr />
    <dl class="row mt-4">
        @* NOTA *@
        <dt class="col-sm-2">
            Notă (Rating)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Rating) / 5
        </dd>

        @* COMENTARIUL *@
        <dt class="col-sm-2">
            Comentariu
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Comment)
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        @* Pastram ID-ul recenziei ascuns ca sa stie sistemul ce sa stearga *@
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Șterge Definitiv</button>
        <a asp-action="Index" class="btn btn-link text-dark">Înapoi la Listă</a>
    </form>
</div>